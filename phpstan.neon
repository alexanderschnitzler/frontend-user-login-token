includes:
	- vendor/phpstan/phpstan-strict-rules/rules.neon
	- %currentWorkingDirectory%/phpstan-baseline.neon

parameters:
	phpVersion: 80400
	level: 8
	treatPhpDocTypesAsCertain: false
	reportWrongPhpDocTypeInVarTag: true

	# Listed explicitly instead of analysing the whole project: functional test instances below
	# public/ symlink the extension back into themselves, so walking the project root loops.
	paths:
		- %currentWorkingDirectory%/Classes
		- %currentWorkingDirectory%/Configuration
		- %currentWorkingDirectory%/Tests
		- %currentWorkingDirectory%/ext_emconf.php
		- %currentWorkingDirectory%/ext_localconf.php

	reportMaybesInPropertyPhpDocTypes: false
